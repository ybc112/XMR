# 复制为 .env 并填写真实值（.env 已被 gitignore，不会提交）

# ===== 部署钱包 =====
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
PRIVATE_KEY=your_private_key_here
BSCSCAN_API_KEY=your_bscscan_api_key

# ===== 多签钱包配置（deploy.js 读取）=====
# 多签管理员钱包地址，逗号分隔（至少 MULTISIG_REQUIRED 个）
# 注意：默认 MULTISIG_REQUIRED=2，若 MULTISIG_OWNERS 少于 2 个地址，部署会失败
MULTISIG_OWNERS=0xowner1,0xowner2,0xowner3
MULTISIG_REQUIRED=2

# USDT 地址（可选，默认 BSC 主网 USDT 0x55d398...；测试网部署必须显式指定）
# USDT_ADDRESS=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
