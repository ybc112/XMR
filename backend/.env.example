# 服务端口
PORT=3001

# BSC RPC节点
BSC_RPC_URL=https://bsc-dataseed.binance.org

# 合约地址
STAKING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
XMR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000001
MULTISIG_WALLET_ADDRESS=0x0000000000000000000000000000000000000002
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# 管理员私钥（仅在服务端使用，切勿暴露到前端）
ADMIN_PRIVATE_KEY=your_admin_private_key_here

# 管理员API密钥（用于管理路由认证，请求头 admin-key）
ADMIN_API_KEY=your_admin_api_key_here

# 事件扫描配置
# 起始扫描区块（0表示从合约部署开始）
START_BLOCK=0
# 扫描间隔（毫秒）
SCAN_INTERVAL=15000
# 单次查询区块范围（BSC建议不超过5000）
SCAN_BATCH_SIZE=2000
