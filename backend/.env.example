# 服务端口
PORT=3001

# BSC RPC节点（测试网: https://bsc-testnet.bnbchain.org）
BSC_RPC_URL=https://bsc-dataseed.binance.org

# 链 ID：56 主网 / 97 测试网
CHAIN_ID=56

# 合约地址
STAKING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
XMR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000001
MULTISIG_WALLET_ADDRESS=0x0000000000000000000000000000000000000002
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# 管理员私钥（仅在服务端使用，切勿暴露到前端）
ADMIN_PRIVATE_KEY=your_admin_private_key_here

# 管理员API密钥（必填，无默认值；用于管理路由认证，请求头 admin-key，未配置启动直接报错）
ADMIN_API_KEY=your_admin_api_key_here

# 管理后台 JWT 密钥（必填，无默认值；用于后台登录令牌签发与校验，请使用足够长的随机字符串）
ADMIN_JWT_SECRET=your-jwt-secret-change-me

# 独立后台管理系统引导管理员账号（必填；仅首次启动且后台账号表为空时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-change-me

# SQLite 数据库文件路径（事件持久化/后台账号/操作日志；留空使用默认 backend/data/xmr.db，目录不存在会自动创建）
DB_PATH=

# CORS 允许的跨域来源（逗号分隔，如 https://admin.example.com,https://dapp.example.com；留空=允许所有来源，启动时会打印警告）
CORS_ORIGINS=

# 事件扫描配置
# 起始扫描区块（0表示从合约部署开始）
START_BLOCK=0
# 扫描间隔（毫秒）
SCAN_INTERVAL=15000
# 单次查询区块范围（BSC建议不超过5000）
SCAN_BATCH_SIZE=2000
